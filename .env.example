# ---------------------------------------------------------------------------
# EcoCity ESG - Modelo de variáveis de ambiente
# Copie para .env antes de subir a stack:  cp .env.example .env
# ---------------------------------------------------------------------------

# Credenciais do MongoDB (usuário root compartilhado entre os dois ambientes)
MONGO_ROOT_USERNAME=admin

# Senhas isoladas por ambiente
MONGO_STAGING_PASSWORD=stagingpassword
MONGO_PROD_PASSWORD=prodpassword

# Nome do banco de dados da aplicação
MONGO_DATABASE=ecocity_esg

# Portas expostas no host
STAGING_PORT=8081
PROD_PORT=8080
